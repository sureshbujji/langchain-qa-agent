# Copy to .env and fill in. Everything below is OPTIONAL:
# the agent, chains, eval, and tests all run offline without any of these.

# --- Real chat model (optional) -------------------------------------------
# Used only if you swap DeterministicFakeChatModel for a real model in
# src/agent.py get_model(). Requires: pip install langchain-openai
OPENAI_API_KEY=sk-your-key-here

# --- LangSmith observability (optional, off by default) --------------------
# Set these three to trace agent steps, tool calls, and chain runs in LangSmith.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=lsv2-your-key-here
LANGCHAIN_PROJECT=langchain-qa-agent
